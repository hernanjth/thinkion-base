# ============================================================
# THINKION BASE — Variables de entorno
# ============================================================
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commitees .env.local — está en .gitignore.
# En producción, estas variables van en Vercel → Settings → Environment Variables.
# ============================================================


# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: https://tu-app.vercel.app (o tu dominio custom)


# ------------------------------------------------------------
# SUPABASE — Base de datos + Auth + Storage
# Obtenerlos en: https://supabase.com → tu proyecto → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Service role key — SOLO para server-side (server actions, API routes)
# NUNCA exponerla en el cliente (sin el prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Prisma connection string — obtenela en Supabase → Settings → Database → Connection string → URI
# Usá la connection string con "Transaction" mode (puerto 6543) para Prisma en serverless
DATABASE_URL=postgresql://postgres.tu-proyecto:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (para migraciones con Prisma — no PgBouncer)
DIRECT_URL=postgresql://postgres.tu-proyecto:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres


# ------------------------------------------------------------
# GOOGLE OAUTH — Login restringido a @tudominio.com
# Configurado automáticamente vía Supabase Auth → Providers → Google
# Solo necesitás el Client ID y Secret de Google Cloud Console
# Estos van en Supabase dashboard, no directamente acá.
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=tu-google-client-secret


# ------------------------------------------------------------
# GOOGLE SHEETS — Exports / catálogos
# Service Account con acceso al Sheet
# Obtener JSON key en: Google Cloud Console → IAM → Service Accounts
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-sa@tu-proyecto.iam.gserviceaccount.com
# La private key tiene saltos de línea — guardala entre comillas dobles, con \n literal
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu-private-key-aqui\n-----END PRIVATE KEY-----\n"

# ID del Google Sheet (está en la URL del Sheet)
GOOGLE_SHEET_ID=tu-sheet-id-aqui

# ID de la Shared Drive para exportaciones (aparece en la URL de la unidad compartida)
# La SA debe tener rol "Administrador de contenido" en esa Shared Drive
GOOGLE_EXPORT_DRIVE_ID=tu-shared-drive-id-aqui


# ------------------------------------------------------------
# HUBSPOT — Deals y tareas
# Obtener en: HubSpot → Settings → Integrations → Private Apps
# ------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=pat-na1-tu-token-aqui

# ID del pipeline de deals. Verificar con GET /crm/v3/pipelines/deals — suele ser "default"
HUBSPOT_PIPELINE_ID=default
# ID del owner de facturación (HubSpot user ID, no portal ID)
HUBSPOT_OWNER_FACTURACION_ID=tu-owner-id-aqui


# ------------------------------------------------------------
# RESEND — Emails transaccionales
# Obtener en: https://resend.com → Settings → API Keys
# ------------------------------------------------------------
RESEND_API_KEY=re_tu-api-key-aqui
RESEND_FROM_EMAIL=noreply@tudominio.com


# ------------------------------------------------------------
# SUPABASE STORAGE — Para PDFs y archivos
# Los buckets se crean desde Supabase dashboard → Storage
# ------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_DOCS=documentos


# ------------------------------------------------------------
# ANTHROPIC — Para features de IA opcionales
# Obtener en: https://console.anthropic.com → API Keys
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui


# ------------------------------------------------------------
# JIRA — Integración con proyectos Jira
# Obtener token en: https://id.atlassian.com/manage-profile/security/api-tokens
# ------------------------------------------------------------
JIRA_BASE_URL=https://tu-org.atlassian.net
JIRA_EMAIL=tu-email@tudominio.com
JIRA_API_TOKEN=tu-jira-api-token-aqui
JIRA_PROJECT_KEY=OB
